# Copia este archivo como .env y cambia los valores.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=calibralab
POSTGRES_USER=calibralab
POSTGRES_PASSWORD=calibralab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Correo de los avisos (RF-28). Con el backend de consola los correos se muestran en la terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CalibraLab <avisos@calibralab.example>
# Dirección con la que se abre el sistema; los códigos QR apuntan aquí.
URL_SISTEMA=http://localhost:8000
# Firma de los QR. Ponla una vez y no la cambies: los QR impresos dejan de funcionar si cambia.
QR_CLAVE=cambia-esta-clave-tambien

# Lectura de certificados con IA (opcional). Sin clave, el botón no aparece.
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-opus-5-5
# IA_MAXIMO_HOJAS=3
